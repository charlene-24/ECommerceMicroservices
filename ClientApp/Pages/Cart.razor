@page "/cart"
@layout MainLayout
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<h3 class="mb-4" style="color: #6b2a2a; font-family: 'Caveat', cursive; font-size: 3rem;">Your Cart</h3>

@if (cartItems == null)
{
    <p>Loading cart...</p>
}
else if (cartItems.Count == 0)
{
    <p>Your cart is empty. <a href="/dashboard">Go back to the store!</a></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in cartItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>₱@item.Price.ToString("0.00")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItem(item)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-end">Total: ₱@cartItems.Sum(i => i.Price).ToString("0.00")</h4>
}

@code {
    private List<ProductModel>? cartItems;

    protected override async Task OnInitializedAsync()
    {
        cartItems = await LocalStorage.GetItemAsync<List<ProductModel>>("cart") ?? new List<ProductModel>();
    }

    private async Task RemoveItem(ProductModel item)
    {
        cartItems.Remove(item);
        await LocalStorage.SetItemAsync("cart", cartItems!);
    }

    public class ProductModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
    }
}
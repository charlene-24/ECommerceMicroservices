@page "/dashboard"
@layout MainLayout

<div class="container mt-5 text-center">
    <h1 style="color: #6b2a2a; font-family: 'Caveat', cursive; font-size: 4rem;">Welcome to Sweet Treats!</h1>
    <p class="lead text-muted mb-5">Your daily dose of freshly baked happiness.</p>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4" style="background-color: #fcfaf8;">
                <h3 class="mb-3">Ready to order?</h3>
                <a href="/products" class="btn btn-lg text-white w-100" style="background-color: #c27c7c;">
                    Browse our Menu
                </a>
            </div>
        </div>
    </div>
</div>